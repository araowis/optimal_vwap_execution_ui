# VWAP Trading Dashboard Environment Variables

# Backend API Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:4567
NEXT_PUBLIC_WS_URL=ws://localhost:4567

# API Keys (if using external services)
NEXT_PUBLIC_API_KEY=your_api_key_here

# Upstox Integration (Optional)
NEXT_PUBLIC_UPSTOX_API_KEY=your_upstox_api_key
NEXT_PUBLIC_UPSTOX_CLIENT_ID=your_upstox_client_id

# Analytics (Optional)
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# Feature Flags
NEXT_PUBLIC_ENABLE_BACKEND_INTEGRATION=true
NEXT_PUBLIC_ENABLE_UPSTOX_API=false
NEXT_PUBLIC_ENABLE_WEBSOCKET=false

# Application Mode
NEXT_PUBLIC_APP_ENV=development

# Notes:
# - Copy this file to .env.local for local development
# - Copy this file to .env.production for production
# - All NEXT_PUBLIC_* variables are accessible in browser
# - Keep API keys secure in production
# - Use environment-specific configuration for staging/production
